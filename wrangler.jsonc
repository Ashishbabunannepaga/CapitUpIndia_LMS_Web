{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "capitup-lms-web",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Runs the Worker next to the D1 database (region APAC) instead of wherever
  // the request lands. Requests arrive through AWS CloudFront, and Cloudflare
  // took about half of them in Los Angeles (cf-ray ...-LAX), where every
  // database query is a trans-Pacific round trip. Smart placement never
  // kicked in at this traffic level (cf-placement: local-LAX / local-SIN), so
  // the Worker is pinned near Singapore. The cf-placement response header
  // shows where a request ran ("remote-SIN" when this works).
  "placement": { "region": "aws:ap-southeast-1" },
  // Keeps the upload under the Workers Free plan's 3 MB (gzipped) limit; see
  // scripts/next-build-for-cloudflare.mjs. Check with `npx wrangler deploy --dry-run`.
  "minify": true,
  // worker.ts imports server code that starts with `import "server-only"`.
  "alias": { "server-only": "./src/worker/server-only-stub.ts" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "capitup-lms-prod",
      "database_id": "8b91cecb-2d26-460f-8e01-bcd31dee3d48",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CARDS",
      "bucket_name": "capitup-lms-visiting-cards"
    }
  ],
  // Every minute (UTC): deliver due renewal reminders; every 5 minutes also
  // the health check, and at 03:30 UTC (09:00 IST) the daily monitoring
  // report. See src/worker/scheduled.ts and docs/monitoring.md.
  "triggers": { "crons": ["* * * * *"] },
  // The deployed version's id, shown by /api/health. Not a resource.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "APP_TIMEZONE": "Asia/Kolkata",
    // Public address of the app. Kept here, not in the dashboard: every deploy
    // replaces dashboard variables with this file. Change it with the domain.
    "BETTER_AUTH_URL": "https://lms.capitupindia.com"
  }
  // Secrets (dashboard or `wrangler secret put`, never in this file; they
  // survive deploys): BETTER_AUTH_SECRET, OPENAI_API_KEY, SETUP_CODE
  // until the first admin exists, and optionally OFFICE_EMAIL +
  // OFFICE_PASSWORD for the Office portal page (docs/office-portal.md),
  // and APP_API_URL + APP_LEADS_TOKEN for Admin > App leads (the CapitUp
  // app's opted-in users; APP_LEADS_TOKEN = the app server's LEADS_API_TOKEN).
  // Monitoring alerts (docs/monitoring.md), all optional: ALERT_NTFY_TOPIC
  // (phone push via the ntfy app), ALERT_WEBHOOK_URL (Slack/Discord/Google
  // Chat), ALERT_TELEGRAM_BOT_TOKEN + ALERT_TELEGRAM_CHAT_ID.
}
