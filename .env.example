# Supabase project settings (Project Settings > API Keys).
# Safe for the browser: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Bypasses RLS; never prefix with NEXT_PUBLIC_ or expose to the client.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server-only. Gemini key for AI intake, visiting card OCR, follow-ups and
# bulk column mapping. Without it the app falls back to basic extraction.
# Never expose it to the browser.
GEMINI_API_KEY=

# Inngest runs the renewal reminder job. In production the Inngest Vercel
# integration sets both keys; never set INNGEST_DEV there.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only: talk to `npx inngest-cli@latest dev` instead of
# Inngest Cloud (the SDK defaults to Cloud and refuses to run without keys).
# INNGEST_DEV=1
