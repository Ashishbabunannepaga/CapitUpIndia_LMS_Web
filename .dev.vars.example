# Copy to .dev.vars for local development. Never commit .dev.vars.
# Any long random string; production uses its own, set in the Cloudflare dashboard.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
GEMINI_API_KEY=
# Opens /setup on an empty database so you can create the first admin locally.
SETUP_CODE=local-setup-code-123
