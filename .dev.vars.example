# Copy to .dev.vars for local development. Never commit .dev.vars.
# Any long random string; production uses its own, set in the Cloudflare dashboard.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
OPENAI_API_KEY=
# Opens /setup on an empty database so you can create the first admin locally.
SETUP_CODE=local-setup-code-123
# Optional: an account on capitupindia.com/office for the Office portal page.
# Leave empty to show only the link. Use a read-only (admin, not super admin) account.
OFFICE_EMAIL=
OFFICE_PASSWORD=

# Browser push notifications (optional; docs/push-notifications.md).
# Make a pair with: node scripts/vapid-keys.mjs
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
