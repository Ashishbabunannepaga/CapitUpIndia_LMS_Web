# Cloudflare Workers static assets: response headers for files in public/ and
# Next.js build output. File names under /_next/static/ carry a content hash,
# so a browser may keep them for a year and never ask again. Without this
# every page load re-checked each script with the Worker (about 300 ms to
# 1.3 s each through CloudFront).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The push service worker must never be stale: a browser checks it for updates
# on every visit, and a cached copy would keep old notification behaviour.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
